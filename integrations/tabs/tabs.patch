+  openPicker(place) {
+    const space = spaces().find(s => s.active);
+    if (!space) return;
+    if (this.picker) try { closeOverlay(this.picker); } catch {}
+    this.picker = openOverlay({ mod: "herdr-inline-markdown", kind: "dialog", width: 560, height: 460, props: { action: "open", place, space: space.id } });
+  }
