+    const place = /^\s*markdown(?:[:\s]\s*(tab|pane))?\s*$/i.exec(String(command))?.[1]?.toLowerCase();
+    if (place === "pane") this.openPicker("pane");
+    else if (place === "tab" || /^\s*markdown\s*$/i.test(String(command))) this.openPicker("tab");
+  }
