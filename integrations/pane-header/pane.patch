+// A Markdown pane (my-markdown) publishes { name, mode } under its pane id, and switches between its page and its source
+// when the toggle raises the counter under its pane. Mods can't import each other, so the names are repeated there.
+const MD_MOD = "my-markdown", MD_HEADS = "my-markdown.heads", MD_TOGGLE = "my-markdown.toggle";
+const MD_ICON = "mods/my-markdown/file-markdown.svg";
+
+function markdownHead(p) {
+  return p.mod === MD_MOD ? shared(MD_HEADS)?.[p.pane] ?? null : null;
+}
